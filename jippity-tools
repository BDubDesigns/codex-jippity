#!/usr/bin/env python3
"""Scan jippity's tools/ directory and emit either a JSON description
or a plain-text index block to prepend to codex prompts.

Tool file format (front-matter as comments):
    # @tool <name>
    # @description <one-line>
    # @command <invocation>          (optional)
    # @usage <usage line>            (repeatable)
    # @example <example command>     (optional, repeatable)
    # @instruction <guidance>        (optional, repeatable)
    # @installed-by <external|jippity> [<notes>]

Usage:
    jippity-tools                  # print tools index block to stdout
    jippity-tools --json           # print JSON array to stdout
    jippity-tools --list           # print one tool name per line

Empty/comment-only files # not starting with @tool are skipped.
Nonexistent tools/ dir → empty output, exit 0.
"""
import json
import os
import shlex
import sys
from jippity_common import parse_manifest


def tools_dir():
    here = os.path.dirname(os.path.abspath(__file__))
    return os.path.join(here, "tools")


def parse_tool(path):
    return parse_manifest(path)


def shell_command_path(path):
    """Return a shell-safe path without exposing a home-relative install path."""
    home = os.path.abspath(os.path.expanduser("~"))
    path = os.path.abspath(path)
    if path.startswith(home + os.sep):
        relative = os.path.relpath(path, home)
        return '"${HOME}"/' + shlex.quote(relative)
    return shlex.quote(path)


def load_tools():
    d = tools_dir()
    if not os.path.isdir(d):
        return []
    tools = []
    for name in sorted(os.listdir(d)):
        path = os.path.join(d, name)
        if not os.path.isfile(path) or name.startswith("."):
            continue
        t = parse_tool(path)
        if t:
            # Older manifests use the tool name as their command implicitly.
            if not t["command"]:
                t["command"] = t["name"]
            # Bundled commands are always advertised with a stable absolute path,
            # so a Codex process started outside this repository can invoke them.
            if t["command"] and t["installed_by"].startswith("jippity"):
                try:
                    parts = shlex.split(t["command"])
                except ValueError:
                    parts = []
                bundled = os.path.join(os.path.dirname(os.path.abspath(__file__)), parts[0]) if parts else ""
                if bundled and os.path.isfile(bundled) and os.access(bundled, os.X_OK):
                    t["command"] = " ".join([shell_command_path(bundled)] + [shlex.quote(p) for p in parts[1:]])
            tools.append(t)
    return tools


def index_block(tools):
    if not tools:
        return ""
    lines = ["[Available jippity tools]"]
    lines.append("You can invoke these via the shell. Use sparingly and only "
                 "when the user asks or when they clearly help answer.")
    for t in tools:
        lines.append(f"- {t['name']}: {t['description']}")
        if t["command"]:
            lines.append(f"    command: {t['command']}")
        for u in t["usage"]:
            lines.append(f"    usage: {u}")
        for ex in t["example"]:
            lines.append(f"    example: {ex}")
        for instruction in t["instruction"]:
            lines.append(f"    instruction: {instruction}")
        if t["installed_by"]:
            lines.append(f"    installed-by: {t['installed_by']}")
    return "\n".join(lines)


def main():
    fmt = "block"
    if "--json" in sys.argv:
        fmt = "json"
    elif "--list" in sys.argv:
        fmt = "list"
    tools = load_tools()
    if fmt == "json":
        print(json.dumps(tools, ensure_ascii=False, indent=2))
    elif fmt == "list":
        for t in tools:
            print(t["name"])
    else:
        out = index_block(tools)
        if out:
            print(out)


if __name__ == "__main__":
    main()
